//@version=6
// =============================================================================
// "Liquidity Toolkit | T" — LINE reconstruction
//
// PROVEN:  T:{tf} = ta.rma(close, 14)  on that timeframe's own bars.
// Forward-computed from an SMA(14) seed against the original's own output:
// from bar 300 on, mean|diff| 5.79e-12, max 1.71e-10, 100.00% exact over 2,686
// hourly bars. Bit-identical, not a fit. (Earlier bars differ only while the
// recursion seed washes out: 0.287 at bar 40 -> 8.3e-5 at 150 -> 2.0e-6 at 200.)
//
// v2 — SAMPLING FIX. v1 used a plain request.security, which on a lower-timeframe
// chart returns the last CONFIRMED htf bar, so its steps lagged the original.
// The original folds in the FORMING htf bar's current close, which is why T:5
// moves on every 3m bar. Not lookahead — the forming bar's price is known now —
// just more responsive. `liveBar` reproduces it:
//     displayed = rmaConfirmed + (close - rmaConfirmed) / len
//
// For BACKTESTING keep liveBar = false. The confirmed reading is the one that is
// stable once printed; the live reading moves within the htf bar, so a signal
// taken from it must be evaluated at the chart bar's close, not after the fact.
//
// STILL NOT SOLVED (58 of the original's 60 outputs): the alertconditions
// (only ~80-87% of its crossover flags coincide with a T5/TH crossing — the rest
// fire with the lines a median 133 pts apart), the band/"Plot" edges, the ten
// `data` plots, the colorers, Trigger Strength, Recovery Opportunity.
// =============================================================================

indicator("T reconstruction — RMA(close,14) MTF", "T recon", overlay = true)

len     = input.int(14,    "RMA length", minval = 1)
liveBar = input.bool(true, "Include forming HTF bar (matches original; off = backtest-safe)")
showAll   = input.bool(false, "Show D / W / M")
useManual = input.bool(true,  "Manual recursion (avoids request.security duality)")

// Two ways to build it.
//  manual  — track htf bars on the chart and run the recursion ourselves. Avoids
//            request.security's real-time/historical duality, where it returns the
//            CONFIRMED htf value on historical bars but the FORMING one on the live
//            bar, so "conf + (close-conf)/len" double-counts the last step there.
//            Exact when the chart tf divides the htf (e.g. 3m chart -> 60m: 20 bars).
//  security — simpler, but carries that duality.
trigManual(simple string tf) =>
    isNew = ta.change(time(tf)) != 0
    var float rConf   = na
    var int   seen    = 0
    var float seedSum = 0.0
    if isNew and not na(close[1])
        pc = close[1]                       // last chart close of the htf bar that just ended
        if seen < len
            seedSum += pc
            seen    += 1
            if seen == len
                rConf := seedSum / len
        else
            rConf := rConf + (pc - rConf) / len
    na(rConf) ? na : liveBar ? rConf + (close - rConf) / len : rConf

trigSecurity(simple string tf) =>
    conf = request.security(syminfo.tickerid, tf, ta.rma(close, len),
                            lookahead = barmerge.lookahead_off)
    liveBar and not na(conf) ? conf + (close - conf) / len : conf

// Manual recursion is limited to the bars loaded on the CHART. On a 3m chart
// that is ~40 days, i.e. only ~40 daily bars — not enough for RMA(14) to shake
// off its SMA seed, which is why T:D read ~11 pts high. request.security runs on
// the native series with full history and the correct CME session boundary, so
// D/W/M always use it; intraday keeps the manual path, which is exact whenever
// the chart timeframe divides the target (3m -> 60m).
trig(simple string tf) =>
    hi = tf == "D" or tf == "W" or tf == "M"
    useManual and not hi ? trigManual(tf) : trigSecurity(tf)

t1 = trig("1")
t5 = trig("5")
tH = trig("60")
tD = trig("D")
tW = trig("W")
tM = trig("M")

plot(t1, "T:1", color = color.new(#26A69A, 40), linewidth = 1)
plot(t5, "T:5", color = #26A69A,                linewidth = 2)
plot(tH, "T:H", color = #0097A7,                linewidth = 2)
plot(showAll ? tD : na, "T:D", color = #FFF59D,               linewidth = 2)
plot(showAll ? tW : na, "T:W", color = color.new(#FFF59D, 40), linewidth = 1)
plot(showAll ? tM : na, "T:M", color = color.new(#FFF59D, 70), linewidth = 1)
